MICROCMS_SERVICE_DOMAIN=your-service-domain
MICROCMS_API_KEY=your-api-key

# SEO/OGP/構造化データ/サイトマップで使うサイトURLとサイト名。未設定時は現行のVercelドメイン・
# 「クジラウォッチ」にフォールバックする。独自ドメイン(kujira-watch.com)をVercelに接続したら、
# Vercelの環境変数側でこの値を設定して反映する。
NEXT_PUBLIC_SITE_URL=https://kujira-watch.com
NEXT_PUBLIC_SITE_NAME=クジラウォッチ

# 訪問者カウンター(フッター表示)用。トレーディングシステム側(stock-alertリポジトリルート)と
# 同じSupabaseプロジェクトを使う。値はルートの.envと同じものを設定する。
SUPABASE_URL=https://kxrgyguowxtjqexvmlgx.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Google AdSense。未設定なら広告スクリプト・広告枠・/ads.txt のすべてが無効（何も出ない）。
# 審査に通ってIDが発行されたらVercelの環境変数に設定する。
# スロットIDは掲載位置ごとに別の広告ユニットを作る（AdSense管理画面で収益を分けて見るため）。
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_INFEED_SLOT=0000000000
# NEXT_PUBLIC_ADSENSE_BOTTOM_SLOT=0000000000
